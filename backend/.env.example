# Copy to .env and fill in:  cp .env.example .env
# NEVER commit a filled .env to git.

# --- Server ---
# Port the backend listens on (default 8007).
PORT=8007

# Shared secret for API auth. Every request to /api/* must carry it as the
# X-API-Key header. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-to-a-long-random-secret

# Comma-separated list of browser origins allowed to call the API with
# credentials (no "*" allowed). Add your deployed frontend origin here.
ALLOWED_ORIGINS=http://localhost:3000

# SQLAlchemy URL. Default is local SQLite; for production use e.g.
# postgresql+asyncpg://user:password@host:5432/ads_runner
DATABASE_URL=sqlite+aiosqlite:///./ads_runner.db

# --- LLM provider keys (bring your own) ---
# Ad generation calls a REAL LLM via litellm. Supply the key for whichever
# provider model you choose (or run local Ollama — no key needed).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ZHIPUAI_API_KEY=
